    <select id="getPageList" resultType="vip.xiaonuo.sys.modular.hr.personnel.vo.PersonnelListVo">
        SELECT a.ID,a.FILE_NO, a.`NAME`,a.SEX,a.BIRTH,a.ID_NUMBER,a.HIRE_DATE,a.POSITIVE_TIME,a.DUTY,b.`NAME`
            AS DEPT,a.`STATUS`,a.EMPLOY_NATURE, su.ID as sysUserId FROM PERSONNEL a LEFT JOIN SYS_ORG b ON a.DEPT_ID = b.ID LEFT JOIN SYS_POSITION c ON a.DUTY_ID=c.ID
            LEFT JOIN SYS_USER su on  a.PHONE = su.ACCOUNT
            ${ew.customSqlSegment}
    </select>

    <select id="info" resultMap="BaseResultMap" parameterType="String">
        SELECT  a.ID, a.FILE_NO, a.`NAME`, a.DEPT_ID, a.DUTY_ID, a.`STATUS`, a.SEX, a.ID_NUMBER, a.BIRTH,
                a.AGE, a.ID_INVALID, a.NATION, a.POLITICS_STATUS, a.ORIGO, a.CENSUS, a.PHONE, a.EMAIL, a.MARITAL_STATUS,
                a.FERTILITY_STATUS, a.EMERGENCY, a.CONTACT, a.ADDRESS, a.HIGHEST_EDUCATION, a.GRADUATE_SCHOOL,
                a.MAJOR, a.NOTES, a.HIRE_DATE, a.EMPLOY_NATURE, a.START_DATE, a.ENTERAGE, a.TRIAL_PERIOD, a.POSITIVE_TIME,
                a.RENEW_TIME, a.FIRST_CONTRACT, a.CONTRACT_UNIT, a.ATTACHMENTS, a.IMAGE, a.POSITIVE_AGE, a.WORK_EXPERIENCE,
                a.MOVE_RECORD, a.FIRST_DEGREE, a.FIRST_DEGREE_CLASS, a.FIRST_GRADUATE_DATE, a.FIRST_GRADUATE_SCHOOL,
                a.FIRST_MAJOR, a.FIRST_NOTE, a.SECOND_DEGREE, a.SECOND_DEGREE_CLASS, a.SECOND_GRADUATE_DATE,
                a.SECOND_GRADUATE_SCHOOL, a.SECOND_MAJOR, a.SECOND_NOTE, a.THIRD_DEGREE, a.THIRD_DEGREE_CLASS,
                a.THIRD_GRADUATE_DATE, a.THIRD_GRADUATE_SCHOOL, a.THIRD_MAJOR, a.THIRD_NOTE, a.EXT_JSON, a.TENANT_ID,
                a.DELETE_FLAG, a.CREATE_TIME, a.CREATE_USER, a.UPDATE_TIME, a.UPDATE_USER , b.`NAME` AS DEPT,c.`NAME` AS DUTY
        FROM PERSONNEL a LEFT JOIN SYS_ORG b ON a.DEPT_ID = b.ID LEFT JOIN SYS_POSITION c ON a.DUTY_ID=c.ID
        WHERE a.`STATUS`= 0 AND a.DELETE_FLAG ='NOT_DELETE' AND a.ID = ${id}
    </select>

    <select id="getFileMovesList" resultType="vip.xiaonuo.sys.modular.hr.fileMoves.entity.PersonnelFileMoves">
        SELECT * FROM PERSONNEL_FILE_MOVES WHERE FILE_ID = #{ID}
    </select>

    <select id="getFileCertList" resultType="vip.xiaonuo.sys.modular.hr.fileMoves.entity.PersonnelFileMoves">
        SELECT * FROM PERSONNEL_FILE_MOVES WHERE FILE_ID = #{ID}
    </select>

    <select id="getStatsResult" parameterType="vip.xiaonuo.sys.modular.hr.personnel.param.PersonnelStatsParam" resultType="vip.xiaonuo.sys.modular.hr.personnel.vo.PersonnelStatsVo">
        SELECT b.`NAME` as dept ,a.* FROM (
        select DEPT_ID ,COUNT(id) as countNum,
        sum(case when Sex = '男' then 1 else 0 end) as countBoy,
        sum(case when Sex = '女' then 1 else 0 end) as countGirl,
        sum(case when HIGHEST_EDUCATION like '博士%' then 1 else 0 end) as countDoctor,
        sum(case when HIGHEST_EDUCATION like '硕士%' then 1 else 0 end) as countMaster,
        sum(case when HIGHEST_EDUCATION like '本科%' then 1 else 0 end) as countBachelor,
        sum(case when HIGHEST_EDUCATION not like '博士%' and HIGHEST_EDUCATION not like '硕士%' and HIGHEST_EDUCATION not like '本科%' then 1 else 0 end) as countAssociate,
        sum(case when (YEAR(NOW())-YEAR(BIRTH)) &lt; 28 then 1 else 0 end) as countAge1,
        sum(case when (YEAR(NOW())-YEAR(BIRTH)) >= 28 and (YEAR(NOW())-YEAR(BIRTH)) &lt; 35 then 1 else 0 end) as countAge2,
        sum(case when (YEAR(NOW())-YEAR(BIRTH)) >= 35 and (YEAR(NOW())-YEAR(BIRTH)) &lt; 45 then 1 else 0 end) as countAge3,
        sum(case when (YEAR(NOW())-YEAR(BIRTH)) >= 45 then 1 else 0 end) as countAge4,
        sum(case when (YEAR(NOW())-YEAR(HIRE_DATE)) &lt; 1 then 1 else 0 end) as countWorkAge1,
        sum(case when  (YEAR(NOW())-YEAR(HIRE_DATE)) >=1 AND (YEAR(NOW())-YEAR(HIRE_DATE)) &lt; 3 then 1 else 0 end) as countWorkAge2,
        sum(case when (YEAR(NOW())-YEAR(HIRE_DATE)) >=3 AND (YEAR(NOW())-YEAR(HIRE_DATE)) &lt; 5 then 1 else 0 end) as countWorkAge3,
        sum(case when (YEAR(NOW())-YEAR(HIRE_DATE)) >=5 then 1 else 0 end) as countWorkAge4
        from PERSONNEL
        where 1 = 1
        <if test="param.deptId != null and param.deptId != ''">
            and DEPT_ID = ${param.deptId}
        </if>
        <if test="param.startHireDate != null and param.startHireDate != ''">
            and HIRE_DATE >= ${param.startHireDate}
        </if>

        <if test="param.endHireDate != null and param.endHireDate != ''">
            and HIRE_DATE &lt;${endHireDate}
        </if>
        group by DEPT_ID
        )  a LEFT JOIN SYS_ORG b on a.DEPT_ID = b.ID
    </select>
</mapper>
