<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.xiaonuo.sys.modular.info.mapper.PartnerInfoMapper">

    <resultMap id="BaseResultMap" type="vip.xiaonuo.sys.modular.info.vo.PartnerInfoVo">
        <id column="ID" jdbcType="VARCHAR" property="id" />
        <id column="TENANT_ID" jdbcType="VARCHAR" property="tenantId" />
        <result column="PARENT_ID" jdbcType="VARCHAR" property="parentId" />
        <result column="DIRECTOR_ID" jdbcType="VARCHAR" property="directorId" />
        <result column="NAME" jdbcType="VARCHAR" property="name" />
        <result column="SN" jdbcType="VARCHAR" property="sn" />
        <result column="CODE" jdbcType="VARCHAR" property="code" />
        <result column="CATEGORY" jdbcType="VARCHAR" property="category" />
        <result column="SORT_CODE" jdbcType="VARCHAR" property="sortCode" />
        <result column="PARTNER_TYPE" jdbcType="VARCHAR" property="partnerType" />
        <result column="REGION" jdbcType="VARCHAR" property="region" />
        <result column="REGIONAL_MANAGER" jdbcType="VARCHAR" property="regionalManager" />
        <result column="PARTNER_NATURE" jdbcType="VARCHAR" property="partnerNature" />
        <result column="CURRENT_RATES" jdbcType="VARCHAR" property="currentRates" />
        <result column="ENTITY" jdbcType="VARCHAR" property="entity" />
        <result column="ADDRESS" jdbcType="VARCHAR" property="address" />
        <result column="TEL_NUMBER" jdbcType="VARCHAR" property="telNumber" />
        <result column="PARTNER_STATUS" jdbcType="VARCHAR" property="partnerStatus" />
        <result column="PHONE_NUMBER" jdbcType="VARCHAR" property="phoneNumber" />
        <result column="POST" jdbcType="VARCHAR" property="post" />
        <result column="EMAIL" jdbcType="VARCHAR" property="email" />
        <result column="PARTNER_LEVEL" jdbcType="VARCHAR" property="partnerLevel" />
        <result column="VITAL_LEVEL" jdbcType="VARCHAR" property="vitalLevel" />
        <result column="EXT_JSON" jdbcType="VARCHAR" property="extJson" />
        <result column="DELETE_FLAG" jdbcType="VARCHAR" property="deleteFlag" />
        <result column="CREATE_TIME" jdbcType="TIMESTAMP" property="createTime" />
        <result column="CREATE_USER" jdbcType="VARCHAR" property="createUser" />
        <result column="STAGES" jdbcType="VARCHAR" property="stages" />
        <result column="CSERVICE" jdbcType="VARCHAR" property="cservice" />
        <result column="CONTACT" jdbcType="VARCHAR" property="contact" />
        <collection property="partnerFees" column="ID" select="getFees" />
        <collection property="partnerRecords" column="ID" select="getRecords" />
        <collection property="partnerPayments" column="ID" select="getPayments" />
    </resultMap>
    
    <select id="infoById" resultMap="BaseResultMap" parameterType="String">
        SELECT pi.*,so.PARENT_ID,so.DIRECTOR_ID,so.CODE,so.CATEGORY
        FROM PARTNER_INFO pi LEFT JOIN SYS_ORG so ON  pi.ORG_ID = so.ID
        where pi.DELETE_FLAG = 'NOT_DELETE'
                   /*and pi.DELETE_FLAG = 'NOT_DELETE'*/
                    and pi.ID = ${id}
    </select>

    <select id="getFees" resultType="vip.xiaonuo.sys.modular.info.entity.PartnerFee">
        select * from PARTNER_FEE where INFO_ID = #{ID} and DELETE_FLAG = 'NOT_DELETE'
    </select>

    <select id="getRecords" resultType="vip.xiaonuo.sys.modular.record.entity.PartnerRecord">
        select * from PARTNER_RECORD where INFO_ID = #{ID} and DELETE_FLAG = 'NOT_DELETE'
    </select>

    <select id="getPayments" resultType="vip.xiaonuo.sys.modular.info.entity.PartnerPayment">
        SELECT * FROM PARTNER_PAYMENT WHERE INFO_ID = #{ID} and DELETE_FLAG = 'NOT_DELETE'
    </select>

    <select id="getPageList" resultType="vip.xiaonuo.sys.modular.info.vo.PartnerInfoVo" >
        select pi.*,so.PARENT_ID,so.DIRECTOR_ID,so.CODE,so.CATEGORY
        FROM  PARTNER_INFO pi LEFT JOIN SYS_ORG so ON  pi.ORG_ID = so.ID AND so.CATEGORY = 'PARTNER'
                                                           AND so.DELETE_FLAG = 'NOT_DELETE'
                                                           ${ew.customSqlSegment}
    </select>
</mapper>
