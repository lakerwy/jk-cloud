<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.xiaonuo.biz.modular.cad.mapper.CadProjectMapper">

    <select id="getPageList" resultType="vip.xiaonuo.biz.modular.cad.vo.CadProjectVo">
        select a.*,b.NAME as managerName
        from BIZ_CAD_PROJECT a
            left join BIZ_CAD_USER b on a.MANAGER = b.ID
            ${ew.customSqlSegment}
    </select>
</mapper>
