<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.xiaonuo.biz.modular.crm.bidopen.mapper.BidopenMapper">

    <update id="updateBizProjectStates" >
          UPDATE BIZ_PROJECT
          set STATES = #{states},
              UPDATE_TIME = current_time
          where ID = #{id}
    </update>
</mapper>
