<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.xiaonuo.biz.modular.invoice.mapper.InvoiceSaleCostMapper">

    <select id="getCostTotal" resultType="vip.xiaonuo.biz.modular.invoice.vo.InvoiceSaleBillTotal">
        select INVOICE_SALE_ID,
               sum(IF(AMOUNT is null,0,AMOUNT)) as amountTotal
        from BIZ_INVOICE_SALE_COST where DELETE_FLAG = 'NOT_DELETE'
        <if test="invoiceSaleIdList != null and invoiceSaleIdList.size() > 0 ">
            and INVOICE_SALE_ID in
            <foreach collection="invoiceSaleIdList" item="item" open="(" close=")" separator=",">
                #{item}
            </foreach>
        </if>
        group by INVOICE_SALE_ID
    </select>

</mapper>
