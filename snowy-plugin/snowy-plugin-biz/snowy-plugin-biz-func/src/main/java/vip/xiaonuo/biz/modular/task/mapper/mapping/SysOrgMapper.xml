<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="vip.xiaonuo.biz.modular.task.mapper.SysOrgMapper">
    <select id="getOrgList" resultType="vip.xiaonuo.biz.modular.task.vo.BizSysOrgVo">
        select ID as orgId,NAME as orgName from SYS_ORG
    </select>

    <select id="getOrgById" resultType="vip.xiaonuo.biz.modular.task.vo.BizSysOrgVo">
        select ID as orgId,NAME as orgName from SYS_ORG where ID = #{orgId}
    </select>
</mapper>
